# KPCL Forecasting Deployment Configuration

# --- Backend Settings ---
# Allowed origins for CORS (comma separated, e.g. http://your-ip-or-domain.com,*)
ALLOWED_ORIGINS=*

# Port for the backend service (default is 8000)
PORT=8000

# --- Frontend Build Args (Optional during docker-compose build) ---
# These can be overridden in the build section of docker-compose.yml
# VITE_API_URL=/api
# VITE_ANALYTICS_URL=/analytics/
